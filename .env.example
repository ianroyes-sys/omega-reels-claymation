# All optional. scripts/build.sh and the Python stages read these; defaults in brackets.
# ffmpeg binary [ffmpeg on PATH]
FFMPEG=
# Python with numpy + scipy for sound.py [python3]
PYTHON_AUDIO=
# whisper.cpp CLI for the qa transcript [whisper-cli on PATH]
WHISPER_CLI=
# whisper model file [models/ggml-large-v3-turbo.bin]
WHISPER_MODEL=
# where finished reels are copied for posting [~/Desktop/Omega Reels]
OMEGA_REELS_DESKTOP=
# hard ceiling on reel length in seconds [70]
MAX_SECONDS=
